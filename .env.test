# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# isolated test database, never touches the production public/data/sqlite.db
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# isolated data dir so manual/service tests never write into public/data
DATA_DIR="%kernel.project_dir%/var/test-data"
DATA_PATH="/test-data"
